cabal-version: 3.0
name:          quickcheck
version:       0.1.0
synopsis:      Property tests of the carbontracker engine through its replay binary
build-type:    Simple

common shared
  default-language: GHC2021
  default-extensions: LambdaCase
  ghc-options:      -Wall -Wno-name-shadowing
  build-depends:
      base >=4.18 && <5
    , aeson >=2.1 && <2.3
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , QuickCheck >=2.14 && <2.19
    , text
    , transformers

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
      Quickcheck.Json
      Quickcheck.Reads
      Quickcheck.Pure
      Quickcheck.Program
      Quickcheck.World
      Quickcheck.Scenario
      Quickcheck.Gen
      Quickcheck.Labels
      Quickcheck.Runner
      Quickcheck.Properties

test-suite quickcheck
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Main.hs
  build-depends:   quickcheck
